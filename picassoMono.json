{
  "description": "picasso.js monorepo packages",
  "packageRules": [
    {
      "groupName": "picasso.js packages",
      "matchSourceUrls": [
        "https://github.com/qlik-oss/picasso.js",
        "https://github.com/qlik-oss/picasso.js/**"
      ]
    },
    {
      "groupName": "picasso.js packages",
      "matchPackageNames": [
