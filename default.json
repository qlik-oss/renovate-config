{
  "description": "Qlik OSS base Renovate preset",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":ignoreUnstable",
    ":renovatePrefix",
    ":updateNotScheduled",
    ":automergeMinor",
    ":maintainLockFilesWeekly",
    ":autodetectPinVersions",
    ":prConcurrentLimit20",
    "github>qlik-oss/renovate-config:picassoMono",
    "github>qlik-oss/renovate-config:nebulaMono",
    "github>qlik-oss/renovate-config:awMono",
    "github>qlik-oss/renovate-config:scriptappyMono",
    "github>qlik-oss/renovate-config:groupMinorPatch"
  ],
  "rebaseStalePrs": true,
  "labels": ["renovate"],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Enable rollback PRs only for yanked packages flagged as security vulnerabilities",
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "rollbackPrs": true
    },
    {
      "description": "Pin GitHub Action to specific digest (commit sha)",
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "description": "Do not apply minimum release age to qlik-oss npm packages",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@qlik/**", "@nebula.js/**"],
      "minimumReleaseAge": null
    }
  ]
}
